# Copy to .env and adjust. .env is gitignored and holds NO secrets by default.
#
# Bee API endpoint. Swarm Desktop exposes this at localhost:1633.
# Must be unauthenticated and local — never put a URL containing a token here.
BEE_API_URL=http://localhost:1633

# Path to the publisher's private key file (32-byte hex).
# Generated by `npm run init`. Gitignored. Back it up somewhere safe:
# lose this and the feed can never be updated again by anyone, ever.
PUBLISHER_KEY_FILE=./publisher.key

# Optional: reuse an existing postage batch instead of buying a new one.
# BATCH_ID=

# Public gateway used by viewer.html and by readers with no node of their own.
PUBLIC_GATEWAY=https://api.gateway.ethswarm.org
